\pard\plain\sa110\sl270\slmult1\f0\fs22 \u1055?\u1086?\u1088?\u1110?\u1074?\u1085?\u1102?\u1108?\u1084?\u1086? \u1089?\u1091?\u1084?\u1080? \u1087?\u1086?\u1082?\u1072?\u1079?\u1085?\u1080?\u1082?\u1110?\u1074? \u1079?\u1072? \u1090?\u1080?\u1084?\u1080? \u1089?\u1072?\u1084?\u1080?\u1084?\u1080? 29 \u1089?\u1087?\u1110?\u1083?\u1100?\u1085?\u1080?\u1084?\u1080? \u1076?\u1085?\u1103?\u1084?\u1080?, \u1097?\u1086? \u1081? \u1091? \u8470?3: 01\u8211?30.08.2019 \u1073?\u1077?\u1079? 05.08 \u1074? \u1086?\u1073?\u1086?\u1093? \u1075?\u1088?\u1091?\u1087?\u1072?\u1093?, \u1073?\u1077?\u1079? \u1079?\u1072?\u1087?\u1086?\u1074?\u1085?\u1077?\u1085?\u1085?\u1103? \u1087?\u1088?\u1086?\u1087?\u1091?\u1089?\u1082?\u1110?\u1074?. \u1055?\u1086?\u1088?\u1103?\u1076?\u1086?\u1082? \u1082?\u1088?\u1086?\u1082?\u1110?\u1074?: {\f1 Impressions \u8594? Website Clicks \u8594? Searches \u8594? View Content \u8594? Add to Cart \u8594? Purchase}.\par
\pard\plain\sa110\sl270\slmult1\f0\fs22 \u1055?\u1086?\u1082?\u1072?\u1079?\u1110?\u1074? \u1085?\u1072?\u1073?\u1072?\u1075?\u1072?\u1090?\u1086? \u1073?\u1110?\u1083?\u1100?\u1096?\u1077?, \u1090?\u1086?\u1084?\u1091? \u1111?\u1093? \u1074?\u1080?\u1085?\u1077?\u1089?\u1077?\u1085?\u1086? \u1074? \u1086?\u1082?\u1088?\u1077?\u1084?\u1091? \u1087?\u1072?\u1085?\u1077?\u1083?\u1100?; \u1086?\u1073?\u1080?\u1076?\u1074?\u1110? \u1087?\u1072?\u1085?\u1077?\u1083?\u1110? \u1084?\u1072?\u1102?\u1090?\u1100? \u1083?\u1110?\u1085?\u1110?\u1081?\u1085?\u1110? \u1086?\u1089?\u1110? \u1079?\u1110? \u1089?\u1074?\u1086?\u1111?\u1084? \u1084?\u1072?\u1089?\u1096?\u1090?\u1072?\u1073?\u1086?\u1084? \u1090?\u1072? \u1087?\u1110?\u1076?\u1087?\u1080?\u1089?\u1080? \u1090?\u1086?\u1095?\u1085?\u1080?\u1093? \u1082?\u1110?\u1083?\u1100?\u1082?\u1086?\u1089?\u1090?\u1077?\u1081?. \u1062?\u1077? \u1087?\u1086?\u1076?\u1077?\u1085?\u1085?\u1110? \u1072?\u1075?\u1088?\u1077?\u1075?\u1072?\u1090?\u1080?, \u1072? \u1085?\u1077? \u1087?\u1110?\u1076?\u1090?\u1074?\u1077?\u1088?\u1076?\u1078?\u1077?\u1085?\u1110? \u1087?\u1086?\u1089?\u1083?\u1110?\u1076?\u1086?\u1074?\u1085?\u1110? \u1096?\u1083?\u1103?\u1093?\u1080? \u1090?\u1080?\u1093? \u1089?\u1072?\u1084?\u1080?\u1093? \u1082?\u1086?\u1088?\u1080?\u1089?\u1090?\u1091?\u1074?\u1072?\u1095?\u1110?\u1074?; \u1088?\u1110?\u1079?\u1085?\u1080?\u1094?\u1103? \u1084?\u1110?\u1078? \u1089?\u1091?\u1089?\u1110?\u1076?\u1085?\u1110?\u1084?\u1080? \u1082?\u1088?\u1086?\u1082?\u1072?\u1084?\u1080? \u1085?\u1077? \u1074?\u1089?\u1090?\u1072?\u1085?\u1086?\u1074?\u1083?\u1102?\u1108? \u1110?\u1085?\u1076?\u1080?\u1074?\u1110?\u1076?\u1091?\u1072?\u1083?\u1100?\u1085?\u1080?\u1081? \u1074?\u1110?\u1076?\u1090?\u1110?\u1082?.\par
\pard\plain\sa130\sl210\slmult1\f1\fs16 import matplotlib.pyplot as plt\line from matplotlib.ticker import StrMethodFormatter\line \line stages = ["Impressions", "Website Clicks", "Searches", "View Content", "Add to Cart", "Purchase"]\line funnel_totals = \{\}\line for group in ["control", "test"]:\line     funnel_frame = pd.read_csv(f"\{group\}_group.csv", sep=";")\line     funnel_frame["Date"] = pd.to_datetime(funnel_frame["Date"], format="%d.%m.%Y")\line     funnel_totals[group] = funnel_frame.set_index("Date").loc[\line         paired.index, [f"# of \{stage\}" for stage in stages]\line     ].sum().to_numpy()\line \line colors = \{"control": "#2878B5", "test": "#E07A32"\}\line fig, axes = plt.subplots(1, 2, figsize=(13, 6), width_ratios=[1, 1.7], layout="constrained")\line for index, group in enumerate(["control", "test"]):\line     impression_bars = axes[0].barh(index, funnel_totals[group][0], color=colors[group], height=0.5)\line     axes[0].bar_label(impression_bars, labels=[f"\{funnel_totals[group][0]:,.0f\}"], padding=5)\line     positions = [step + (index - 0.5) * 0.36 for step in range(5)]\line     stage_bars = axes[1].barh(positions, funnel_totals[group][1:], height=0.34, color=colors[group], label=group)\line     axes[1].bar_label(stage_bars, labels=[f"\{value:,.0f\}" for value in funnel_totals[group][1:]], padding=5)\line \line axes[0].set(yticks=[0, 1], yticklabels=["control", "test"], title="\u1055?\u1086?\u1082?\u1072?\u1079?\u1080? \u1088?\u1077?\u1082?\u1083?\u1072?\u1084?\u1080?", xlim=(0, 4_000_000))\line axes[1].set(yticks=range(5), yticklabels=stages[1:], title="\u1050?\u1088?\u1086?\u1082?\u1080? \u1085?\u1072? \u1089?\u1072?\u1081?\u1090?\u1110?", xlim=(0, 220_000))\line for axis in axes:\line     axis.invert_yaxis()\line     axis.set_xlabel("\u1050?\u1110?\u1083?\u1100?\u1082?\u1110?\u1089?\u1090?\u1100?")\line     axis.xaxis.set_major_formatter(StrMethodFormatter("\{x:,.0f\}"))\line     axis.grid(axis="x", alpha=0.2)\line     axis.set_axisbelow(True)\line     axis.spines[["top", "right"]].set_visible(False)\line axes[0].set_xticks([0, 2_000_000, 4_000_000])\line axes[1].legend(loc="lower right")\line fig.suptitle("\u1042?\u1086?\u1088?\u1086?\u1085?\u1082?\u1080? control \u1110? test \u183? 29 \u1089?\u1087?\u1110?\u1083?\u1100?\u1085?\u1080?\u1093? \u1076?\u1085?\u1110?\u1074?")\line plt.show()\par
