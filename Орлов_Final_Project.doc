\pard\plain\sa110\sl270\slmult1\f0\fs22 \u1063?\u1080?\u1090?\u1072?\u1108?\u1084?\u1086? CSV \u1079? \u1088?\u1086?\u1079?\u1076?\u1110?\u1083?\u1100?\u1085?\u1080?\u1082?\u1086?\u1084? {\f1 ;} \u1090?\u1072? \u1079?\u1110?\u1089?\u1090?\u1072?\u1074?\u1083?\u1103?\u1108?\u1084?\u1086? \u1075?\u1088?\u1091?\u1087?\u1080? \u1079?\u1072? \u1076?\u1072?\u1090?\u1086?\u1102?. \u1042? \u1086?\u1073?\u1086?\u1093? \u1092?\u1072?\u1081?\u1083?\u1072?\u1093? \u1108? 30 \u1091?\u1085?\u1110?\u1082?\u1072?\u1083?\u1100?\u1085?\u1080?\u1093? \u1076?\u1072?\u1090? \u1074?\u1110?\u1076? 01.08 \u1076?\u1086? 30.08.2019 \u1073?\u1077?\u1079? \u1087?\u1086?\u1074?\u1090?\u1086?\u1088?\u1085?\u1080?\u1093? \u1088?\u1103?\u1076?\u1082?\u1110?\u1074?. \u1059? control \u1079?\u1072? 05.08 \u1074?\u1110?\u1076?\u1089?\u1091?\u1090?\u1085?\u1110? \u1087?\u1086?\u1082?\u1091?\u1087?\u1082?\u1080?: \u1094?\u1077? \u1087?\u1088?\u1086?\u1087?\u1091?\u1089?\u1082?, \u1072? \u1085?\u1077? \u1085?\u1091?\u1083?\u1100?. \u1042?\u1080?\u1082?\u1083?\u1102?\u1095?\u1072?\u1108?\u1084?\u1086? \u1094?\u1077?\u1081? \u1076?\u1077?\u1085?\u1100? \u1079? \u1086?\u1073?\u1086?\u1093? \u1075?\u1088?\u1091?\u1087? \u1073?\u1077?\u1079? \u1079?\u1072?\u1087?\u1086?\u1074?\u1085?\u1077?\u1085?\u1085?\u1103?; \u1079?\u1072?\u1083?\u1080?\u1096?\u1072?\u1108?\u1090?\u1100?\u1089?\u1103? 29 \u1087?\u1072?\u1088? \u1076?\u1072?\u1090?. \u1042?\u1080?\u1089?\u1085?\u1086?\u1074?\u1086?\u1082? \u1089?\u1090?\u1086?\u1089?\u1091?\u1108?\u1090?\u1100?\u1089?\u1103? \u1094?\u1080?\u1093? \u1089?\u1087?\u1110?\u1083?\u1100?\u1085?\u1080?\u1093? \u1089?\u1087?\u1086?\u1089?\u1090?\u1077?\u1088?\u1077?\u1078?\u1091?\u1074?\u1072?\u1085?\u1080?\u1093? \u1076?\u1085?\u1110?\u1074?; \u1087?\u1077?\u1088?\u1077?\u1085?\u1077?\u1089?\u1077?\u1085?\u1085?\u1103? \u1085?\u1072? \u1087?\u1086?\u1074?\u1085?\u1080?\u1081? \u1087?\u1077?\u1088?\u1110?\u1086?\u1076? \u1087?\u1086?\u1090?\u1088?\u1077?\u1073?\u1091?\u1108? \u1087?\u1088?\u1080?\u1087?\u1091?\u1097?\u1077?\u1085?\u1085?\u1103? \u1087?\u1088?\u1086? \u1076?\u1086?\u1087?\u1091?\u1089?\u1090?\u1080?\u1084?\u1110?\u1089?\u1090?\u1100? \u1087?\u1088?\u1086?\u1087?\u1091?\u1089?\u1082?\u1091?.\par
\pard\plain\sa110\sl270\slmult1\f0\fs22 \u1054?\u1073?\u1095?\u1080?\u1089?\u1083?\u1102?\u1108?\u1084?\u1086? \u1089?\u1077?\u1088?\u1077?\u1076?\u1085?\u1102? \u1082?\u1110?\u1083?\u1100?\u1082?\u1110?\u1089?\u1090?\u1100? \u1087?\u1086?\u1082?\u1091?\u1087?\u1086?\u1082? \u1079?\u1072? \u1076?\u1077?\u1085?\u1100? \u1110? \u1088?\u1110?\u1079?\u1085?\u1080?\u1094?\u1102? {\f1 test \u8722? control}. \u1057?\u1091?\u1084?\u1072?\u1088?\u1085?\u1110? \u1074?\u1080?\u1090?\u1088?\u1072?\u1090?\u1080? \u1085?\u1072? \u1090?\u1080?\u1093? \u1089?\u1072?\u1084?\u1080?\u1093? \u1076?\u1085?\u1103?\u1093? \u1085?\u1072?\u1074?\u1086?\u1076?\u1080?\u1084?\u1086? \u1076?\u1083?\u1103? \u1082?\u1086?\u1085?\u1090?\u1077?\u1082?\u1089?\u1090?\u1091?: \u1073?\u1102?\u1076?\u1078?\u1077?\u1090?\u1080? \u1088?\u1110?\u1079?\u1085?\u1110?, \u1090?\u1086?\u1084?\u1091? \u1082?\u1110?\u1083?\u1100?\u1082?\u1110?\u1089?\u1090?\u1100? \u1087?\u1086?\u1082?\u1091?\u1087?\u1086?\u1082? \u1085?\u1077? \u1074?\u1110?\u1076?\u1086?\u1082?\u1088?\u1077?\u1084?\u1083?\u1102?\u1108? \u1077?\u1092?\u1077?\u1082?\u1090? \u1073?\u1102?\u1076?\u1078?\u1077?\u1090?\u1091? \u1090?\u1072? \u1085?\u1077? \u1074?\u1080?\u1084?\u1110?\u1088?\u1102?\u1108? \u1077?\u1092?\u1077?\u1082?\u1090?\u1080?\u1074?\u1085?\u1110?\u1089?\u1090?\u1100? \u1074?\u1080?\u1090?\u1088?\u1072?\u1090?.\par
\pard\plain\sa130\sl210\slmult1\f1\fs16 import pandas as pd\line from scipy.stats import ttest_rel\line \line columns = ["# of Purchase", "Spend [USD]"]\line groups = \{\}\line for group in ["control", "test"]:\line     frame = pd.read_csv(f"\{group\}_group.csv", sep=";")\line     frame["Date"] = pd.to_datetime(frame["Date"], format="%d.%m.%Y")\line     groups[group] = frame.set_index("Date")[columns]\line \line paired = pd.concat(groups, axis=1).dropna().sort_index()\line summary = pd.DataFrame(\{\line     group: \{\line         "mean_daily_purchases": paired[group]["# of Purchase"].mean(),\line         "total_spend_usd": paired[group]["Spend [USD]"].sum(),\line     \}\line     for group in groups\line \}).T\line delta = summary.loc["test", "mean_daily_purchases"] - summary.loc["control", "mean_daily_purchases"]\line display(summary.round(4))\line print(f"\u1056?\u1110?\u1079?\u1085?\u1080?\u1094?\u1103? \u1089?\u1077?\u1088?\u1077?\u1076?\u1085?\u1110?\u1093? (test \u8722? control): \{delta:.4f\} \u1087?\u1086?\u1082?\u1091?\u1087?\u1082?\u1080?/\u1076?\u1077?\u1085?\u1100?")\par
